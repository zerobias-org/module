<?xml version="1.0" encoding="UTF-8"?>
<!--
  Build-time-only schema codegen (DESIGN §6).

  Reads the pyx12-style mapping XML that com.imsweb:x12-parser ships on its
  classpath (mapping/<TS>.<ver>.<guide>.xml, dataele.xml, codes.xml) and emits
  the DataProducer JSON schemas (transactions/loops/segments/composites/codes/
  shared) plus the runtime materializer structure-index into the receiver
  module's src/main/resources. The generated tree is git-ignored and produced
  on every build; the parent java/pom.xml drives this project from its
  generate-resources phase:

    mvn -f codegen/pom.xml compile exec:java \
        -Dexec.mainClass=com.zerobias.module.x12.codegen.SchemaGenerator \
        -Dexec.args="ALL ../src/main/resources"

  Nothing is vendored: the BSD-licensed pyx12 maps are read straight from the
  imsweb jar.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.zerobias.module</groupId>
    <artifactId>x12-schema-codegen</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>x12-schema-codegen</name>
    <description>Build-time generator: imsweb/pyx12 X12 mapping XML -> DataProducer schemas + structure index</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <x12parser.version>1.16</x12parser.version>
        <gson.version>2.10.1</gson.version>
        <junit.version>5.10.0</junit.version>
    </properties>

    <dependencies>
        <!-- Only needed for classpath access to mapping/*.xml (the pyx12 maps). The
             parser classes themselves are not used by the generator. -->
        <dependency>
            <groupId>com.imsweb</groupId>
            <artifactId>x12-parser</artifactId>
            <version>${x12parser.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>
            <!-- All tests read the maps from the x12-parser jar (a compile-scope dep),
                 so plain surefire covers them; no failsafe split is needed here. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>com.zerobias.module.x12.codegen.SchemaGenerator</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
