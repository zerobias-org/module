<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.zerobias.module</groupId>
    <artifactId>x12-receiver</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>x12-receiver</name>
    <description>X12 EDI file receiver (inbox poller) implementing the DataProducer interface</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <x12parser.version>1.16</x12parser.version>
        <javalin.version>6.1.3</javalin.version>
        <gson.version>2.10.1</gson.version>
        <snakeyaml.version>2.2</snakeyaml.version>
        <sqlite.version>3.45.1.0</sqlite.version>
        <slf4j.version>2.0.9</slf4j.version>
        <junit.version>5.10.0</junit.version>
        <!-- -Dcodegen.skip=true skips the schema codegen (and its submodule tests):
             for builds where java/codegen is absent or being written concurrently.
             The shaded jar then ships WITHOUT schemas/ + structure-index/ — never
             use it for an image build. -->
        <codegen.skip>false</codegen.skip>
        <codegen.tests.skip>${skipTests}</codegen.tests.skip>
    </properties>

    <dependencies>
        <!-- X12 wire layer: imsweb X12Reader (separator detection, definition
             selected by GS08, Loop tree, getErrors()/getFatalErrors()). The pyx12
             mapping XML it ships is ALSO the codegen's input (DESIGN §6); the codegen
             submodule declares its own copy of this dep. -->
        <dependency>
            <groupId>com.imsweb</groupId>
            <artifactId>x12-parser</artifactId>
            <version>${x12parser.version}</version>
        </dependency>

        <!-- Operations HTTP server -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>${javalin.version}</version>
        </dependency>

        <!-- JSON -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- YAML: the dev/e2e fallback reads the `config:` block of the
             runtimeConfig.yml copied into the image when MODULE_CONFIG is absent
             (DESIGN §3). Production always gets MODULE_CONFIG; this is never on the
             hot path. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>${snakeyaml.version}</version>
        </dependency>

        <!-- Durable buffer -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- RFC4515 filter -> SQL adapter (DESIGN §2.6). From GitHub Packages
             (zerobias-org/util); see the <repositories> block below. -->
        <dependency>
            <groupId>com.zerobias</groupId>
            <artifactId>lite-filter</artifactId>
            <version>1.0.4</version>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>x12-receiver-1.0.0</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>

            <!-- Generate the X12 schema tree + structure index into resources BEFORE
                 packaging (DESIGN §6). The output is a BUILD ARTIFACT (git-ignored), so
                 it MUST be produced on every build: otherwise the shaded jar ships with
                 no schemas and getSchema/by-type + the materializer silently degrade.
                 Runs the codegen submodule (build-time-only project under java/codegen).
                 Skippable with -Dcodegen.skip=true (see <properties>). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>run-codegen</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${codegen.skip}</skip>
                            <executable>mvn</executable>
                            <arguments>
                                <argument>-f</argument>
                                <argument>codegen/pom.xml</argument>
                                <argument>compile</argument>
                                <argument>exec:java</argument>
                                <argument>-Dexec.mainClass=com.zerobias.module.x12.codegen.SchemaGenerator</argument>
                                <argument>-Dexec.args=ALL ${project.basedir}/src/main/resources</argument>
                            </arguments>
                        </configuration>
                    </execution>

                    <!-- Run the codegen submodule's OWN tests (surefire + failsafe). The
                         submodule is never a reactor member here, so without this its tests
                         silently never run. Bound to `test` because the gate's unit task is
                         `mvn test`; skipped under -DskipTests and under -Dcodegen.skip=true. -->
                    <execution>
                        <id>run-codegen-tests</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${codegen.tests.skip}</skip>
                            <executable>mvn</executable>
                            <arguments>
                                <argument>-f</argument>
                                <argument>codegen/pom.xml</argument>
                                <argument>verify</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.1.2</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Uber JAR -> target/x12-receiver-1.0.0.jar (mainClass X12ApiServer) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>true</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.zerobias.module.x12.X12ApiServer</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- -Dcodegen.skip=true also skips the codegen submodule's tests (an exec
             <skip> takes one boolean, so the OR with skipTests lives here). -->
        <profile>
            <id>skip-codegen</id>
            <activation>
                <property>
                    <name>codegen.skip</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <codegen.tests.skip>true</codegen.tests.skip>
            </properties>
        </profile>
    </profiles>

    <!-- NOTE: schema codegen runs in the DEFAULT build (generate-resources phase),
         not an opt-in profile — the generated tree is git-ignored, so CI must
         regenerate it every build. -->

    <!-- lite-filter is published to GitHub Packages (zerobias-org/util), not Maven
         Central. Auth comes from ~/.m2/settings.xml server id 'github'. -->
    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/zerobias-org/util</url>
        </repository>
    </repositories>
</project>
